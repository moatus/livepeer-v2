#!/usr/bin/env python3
"""./dev demo: the one-command demo of the newest stage, on a fresh local chain.

  ./dev demo              stage 3 (S-05 section 1): stake, scores, claims and
                          LPT rewards, with the node paid in mock USDC
  ./dev demo stage-2      stage 2 (S-09 section 1): the node paid in mock
                          USDC, with no stake
  ./dev demo stage-4      announced parameters, key rotation and recovery
  ./dev demo buyback      the buyback (S-07 section 1): the network share
                          buys test LPT from a test pool and burns it,
                          then Parameters (S-10 R-25) and a node's key
                          rotation (R-26); no node, so no docker

Exit 0 every figure equal and every behaviour seen; 1 a figure differed or
a behaviour was missing; 2 the demo could not run (a tool, a download or a
port). Environment: LP2_DEMO_PORT_BASE (default 47700) moves the ports the
demo uses; LP2_NODE_SOURCE fetches the pinned node commit from another
clone of it.
"""
import argparse
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

parser = argparse.ArgumentParser(prog="./dev demo", description=__doc__.splitlines()[0])
parser.add_argument("stage", nargs="?", choices=("stage-2", "stage-3", "stage-4", "buyback"), default="stage-3",
                    help="which stage's demo to run (default stage-3)")
stage = parser.parse_args().stage
if stage == "stage-2":
    import stage2 as demo
elif stage == "stage-4":
    import stage4 as demo
elif stage == "buyback":
    import buyback as demo
else:
    import stage3 as demo
import common  # noqa: E402

common.run_main(demo.main)
