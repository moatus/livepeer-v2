#!/usr/bin/env python3
"""./dev demo: the one-command demo, on a fresh local chain.

  ./dev demo              rewards: stake, scores, claims and
                          LPT rewards, with the node paid in mock USDC
  ./dev demo payments     the node paid in mock
                          USDC, with no stake
  ./dev demo full         announced parameters, key rotation and recovery
  ./dev demo buyback      the buyback: the network share
                          buys test LPT from a test pool and burns it,
                          then Parameters (R-25), then the buyback
                          moved to a second executor and pool; no node,
                          so no docker
  ./dev demo light        the standing services: lp2-sender refuses bad
                          joins and pays each node that joins, serving
                          lp2-responder, once a round, and lp2-faucet
                          grants each registered node test LPT once,
                          through three kills; no model, no docker
  ./dev demo upgrade      the Broker's code replaced in place on a running
                          full system by demo/public-run upgrade, through
                          three kills, every view read the same across the
                          apply, the command's four refusals, then a stop
                          drill; every figure reconciled
  ./dev demo container    the operator container on the full system with
                          the sender and the faucet: it registers, is
                          granted, bonds, joins, is paid, and claims and
                          withdraws, through three kills; the run as a
                          ledger case the calculator reproduces

Exit 0 every figure equal and every behaviour seen; 1 a figure differed or
a behaviour was missing; 2 the demo could not run (a tool, a download or a
port). Environment: LP2_DEMO_PORT_BASE (default 47700) moves the ports the
demo uses; LP2_NODE_SOURCE fetches the pinned node commit from another
clone of it.
"""
import argparse
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

parser = argparse.ArgumentParser(prog="./dev demo", description=__doc__.splitlines()[0])
parser.add_argument("demo_name", nargs="?", choices=("payments", "rewards", "full", "buyback", "light", "container", "upgrade"), default="rewards",
                    help="which demo to run (default rewards)")
demo_name = parser.parse_args().demo_name
if demo_name == "payments":
    import payments as demo
elif demo_name == "full":
    import full as demo
elif demo_name == "buyback":
    import buyback as demo
elif demo_name == "light":
    import light as demo
elif demo_name == "container":
    import container as demo
elif demo_name == "upgrade":
    import upgrade as demo
else:
    import rewards as demo
import common  # noqa: E402

common.run_main(demo.main)
