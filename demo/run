#!/usr/bin/env python3
"""./dev demo: S-09 section 1 on a fresh local chain.

Starts a local chain, deploys the stage 2 contracts, and runs the
unmodified node (orchestrator and signer) and a tiny model. A stake-free
node registers, a payer funds 10 USDC of mock USDC and earmarks 0.02 USDC,
and six real jobs each settle one ticket. Then: the three refusals where
each happens, a job after 999 junk registrations, a job with the keeper
stopped for five round lengths, and a release requested right after a job.

Every figure read from the chain is printed beside the independent
calculator's figure for the same steps. The run is written as a `ledger`
case and `./calculator/check` reproduces it.

Exit 0 every figure equal and every behaviour seen; 1 a figure differed or
a behaviour was missing; 2 the demo could not run (a tool, a download or a
port). What the node, model and chain are, and every stand-in, is read from
deployments/stage-2-local.json.

Environment: LP2_DEMO_PORT_BASE (default 47700) moves the eight ports the
demo uses; LP2_NODE_SOURCE fetches the pinned node commit from another
clone of it.
"""
from __future__ import annotations

import hashlib
import json
import os
import re
import shutil
import signal
import socket
import subprocess
import sys
import time
import urllib.error
import urllib.request
from pathlib import Path

HERE = Path(__file__).resolve().parent
ROOT = HERE.parent
sys.path.insert(0, str(HERE))
sys.path.insert(0, str(ROOT / "calculator"))
import ledgercase  # noqa: E402

MANIFEST = json.loads((ROOT / "deployments" / "stage-2-local.json").read_text())
VECTORS = json.loads((ROOT / MANIFEST["vectors"]).read_text())
CASES = {c["id"]: c for c in VECTORS["cases"]}
PARAMS = VECTORS["parameters"]
CACHE = ROOT / ".cache" / "demo"
RUN = CACHE / "run"
ZERO = "0x" + "0" * 40
JUNK = 999  # S-09 section 1: a paid job after 999 junk registrations


class NotRun(Exception):
    """The demo could not run: exit 2."""


class Failed(Exception):
    """A figure differed or a behaviour was missing: exit 1."""


LOG = None


def say(text: str = "") -> None:
    print(text, flush=True)
    if LOG:
        LOG.write(text + "\n")
        LOG.flush()


def money(v) -> str:
    return f"{int(v):,}"


# --- processes --------------------------------------------------------------

PROCS: dict[str, subprocess.Popen] = {}
CONTAINERS: list[str] = []


def start(name: str, argv: list[str], cwd: Path | None = None) -> None:
    log = open(RUN / "logs" / f"{name}.log", "w")
    PROCS[name] = subprocess.Popen(argv, cwd=cwd, stdout=log, stderr=subprocess.STDOUT,
                                   stdin=subprocess.DEVNULL, start_new_session=True)


def stop(name: str) -> None:
    p = PROCS.pop(name, None)
    if p and p.poll() is None:
        try:
            os.killpg(p.pid, signal.SIGTERM)
            p.wait(10)
        except (ProcessLookupError, subprocess.TimeoutExpired):
            try:
                os.killpg(p.pid, signal.SIGKILL)
            except ProcessLookupError:
                pass


def cleanup() -> None:
    """Stop everything at once, then wait up to 10 s before killing what is left."""
    for p in PROCS.values():
        try:
            os.killpg(p.pid, signal.SIGTERM)
        except ProcessLookupError:
            pass
    end = time.time() + 10
    for p in PROCS.values():
        try:
            p.wait(max(0.1, end - time.time()))
        except subprocess.TimeoutExpired:
            pass
    for name in list(PROCS):
        stop(name)
    for c in CONTAINERS:
        subprocess.run(["docker", "rm", "-f", c], capture_output=True)
    CONTAINERS.clear()


def sh(argv: list[str], cwd: Path | None = None, check: bool = True, env: dict | None = None) -> str:
    done = subprocess.run(argv, cwd=cwd, capture_output=True, text=True, env=env)
    if check and done.returncode != 0:
        raise Failed(f"{' '.join(argv[:3])} ... failed: {(done.stderr or done.stdout).strip()[-600:]}")
    return done.stdout.strip()


# --- preflight and fetching ---------------------------------------------------

BASE = int(os.environ.get("LP2_DEMO_PORT_BASE", "47700"))
PORT = {"chain": BASE, "orch": BASE + 1, "orch_metrics": BASE + 2, "signer_p": BASE + 3,
        "signer_p_metrics": BASE + 4, "signer_p2": BASE + 5, "signer_p2_metrics": BASE + 6, "model": BASE + 7}


def preflight() -> None:
    missing = [t for t in ("git", "go", "forge", "anvil", "cast", "docker") if not shutil.which(t)]
    if missing:
        raise NotRun(f"missing {', '.join(missing)} (see README: Run the demo)")
    if subprocess.run(["docker", "info"], capture_output=True).returncode != 0:
        raise NotRun("docker is installed but its daemon is not reachable by this user")
    for name, port in PORT.items():
        with socket.socket() as s:
            s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
            try:
                s.bind(("127.0.0.1", port))
            except OSError:
                raise NotRun(f"port {port} ({name}) is in use; set LP2_DEMO_PORT_BASE to move the demo's ports")


def fetch_node() -> Path:
    node = MANIFEST["node"]
    commit = node["commit"]
    home = CACHE / f"node-{commit[:12]}"
    bins = {p: home / "bin" / p for p in node["programs"]}
    if all(b.is_file() for b in bins.values()):
        return home / "bin"
    src = home / "src"
    shutil.rmtree(home, ignore_errors=True)
    src.mkdir(parents=True)
    source = os.environ.get("LP2_NODE_SOURCE", node["source"])
    say(f"  fetching the node at {commit[:12]} from {source}")
    try:
        sh(["git", "init", "-q"], cwd=src)
        sh(["git", "fetch", "-q", "--depth", "1", source, commit], cwd=src)
        sh(["git", "checkout", "-q", "FETCH_HEAD"], cwd=src)
    except Failed as e:
        raise NotRun(f"could not fetch the node: {e}")
    if sh(["git", "rev-parse", "HEAD"], cwd=src) != commit:
        raise NotRun("the fetched node is not the pinned commit")
    say("  building livepeer-orchestrator and livepeer-signer (the first run takes a few minutes)")
    for p, b in bins.items():
        try:
            sh(["go", "build", "-o", str(b), f"./cmd/{p}"], cwd=src)
        except Failed as e:
            raise NotRun(f"could not build the node: {e}")
    return home / "bin"


def fetch_model() -> Path:
    model = MANIFEST["model"]
    path = CACHE / "model" / f"{model['sha256']}.gguf"
    if not path.is_file():
        path.parent.mkdir(parents=True, exist_ok=True)
        say(f"  downloading the model ({model['name']}, about 145 MB)")
        part = path.with_suffix(".part")
        digest = hashlib.sha256()
        try:
            with urllib.request.urlopen(model["url"], timeout=60) as r, open(part, "wb") as f:
                while chunk := r.read(1 << 20):
                    digest.update(chunk)
                    f.write(chunk)
        except (urllib.error.URLError, OSError) as e:
            raise NotRun(f"could not download the model: {e}")
        if digest.hexdigest() != model["sha256"]:
            part.unlink()
            raise NotRun("the downloaded model does not have the pinned sha256")
        part.rename(path)
    image = model["server_image"]
    if subprocess.run(["docker", "image", "inspect", image], capture_output=True).returncode != 0:
        say(f"  pulling the model server image {image}")
        if subprocess.run(["docker", "pull", "-q", image], capture_output=True).returncode != 0:
            raise NotRun(f"could not pull {image}")
    return path


def build_ours() -> Path:
    try:
        sh(["forge", "build", "--root", str(ROOT / "contracts")])
        bin_dir = RUN / "bin"
        for p in ("lp2-fund", "lp2-keeper"):
            sh(["go", "build", "-o", str(bin_dir / p), f"./cmd/{p}"], cwd=ROOT / "programs")
    except Failed as e:
        raise NotRun(f"could not build the contracts or programs: {e}")
    return bin_dir


# --- the chain ----------------------------------------------------------------

RPC = f"http://127.0.0.1:{PORT['chain']}"
SELECTORS: dict[str, str] = {}


def rpc_batch(calls: list[tuple[str, list]]) -> list:
    out = []
    for i in range(0, len(calls), 500):
        chunk = calls[i:i + 500]
        body = json.dumps([{"jsonrpc": "2.0", "id": j, "method": m, "params": p}
                           for j, (m, p) in enumerate(chunk)]).encode()
        req = urllib.request.Request(RPC, data=body, headers={"content-type": "application/json"})
        with urllib.request.urlopen(req, timeout=120) as r:
            answers = sorted(json.loads(r.read()), key=lambda a: a["id"])
        out += answers
    return out


def rpc(method: str, params: list):
    a = rpc_batch([(method, params)])[0]
    if "error" in a:
        raise Failed(f"{method}: {a['error']}")
    return a["result"]


def sel(signature: str) -> str:
    if signature not in SELECTORS:
        SELECTORS[signature] = sh(["cast", "sig", signature])
    return SELECTORS[signature]


def calldata(signature: str, *args) -> str:
    words = "".join(f"{int(a, 16) if isinstance(a, str) else a:064x}" for a in args)
    return sel(signature) + words


def calls(items: list[tuple[str, str, tuple]], block="latest") -> list[int]:
    """eth_call each (contract, signature, args) at one block; the first word of each answer."""
    tag = hex(block) if isinstance(block, int) else block
    answers = rpc_batch([("eth_call", [{"to": to, "data": calldata(sig, *args)}, tag]) for to, sig, args in items])
    out = []
    for a, item in zip(answers, items):
        if "error" in a:
            raise Failed(f"eth_call {item[1]}: {a['error']}")
        out.append(int(a["result"][2:66], 16))
    return out


def words(to: str, signature: str, *args) -> list[int]:
    """Every word a static answer holds, such as earmarkOf's (amount, pending, ready round)."""
    out = rpc("eth_call", [{"to": to, "data": calldata(signature, *args)}, "latest"])[2:]
    return [int(out[i:i + 64], 16) for i in range(0, len(out), 64)]


def call(to: str, signature: str, *args, block="latest") -> int:
    return calls([(to, signature, args)], block)[0]


def block_number() -> int:
    return int(rpc("eth_blockNumber", []), 16)


def mine(n: int) -> None:
    rpc("anvil_mine", [hex(n)])


def receipt(tx: str, timeout: float = 30) -> dict:
    end = time.time() + timeout
    while time.time() < end:
        r = rpc("eth_getTransactionReceipt", [tx])
        if r:
            return r
        time.sleep(0.2)
    raise Failed(f"no receipt for {tx}")


def send(key: str, to: str, signature: str, *args, gas: int | None = None) -> dict:
    argv = ["cast", "send", "--json", "--rpc-url", RPC, "--private-key", key, to, signature, *map(str, args)]
    if gas:
        argv[2:2] = ["--gas-limit", str(gas)]
    done = subprocess.run(argv, capture_output=True, text=True)
    if done.returncode != 0 and not done.stdout.strip().startswith("{"):
        raise Failed(f"send {signature[:40]}: {done.stderr.strip()[-400:]}")
    r = json.loads(done.stdout)
    if gas is None and r["status"] != "0x1":
        raise Failed(f"send {signature[:40]}: reverted")
    return r


# --- names, keys and records --------------------------------------------------

NAMES: dict[str, str] = {}   # lower-case address -> name used in the ledger case
ADDR: dict[str, str] = {}
KEY: dict[str, str] = {}
RECORDS: list[dict] = []


def new_key(name: str) -> None:
    key = "0x" + os.urandom(32).hex()
    addr = sh(["cast", "wallet", "address", key])
    KEY[name], ADDR[name] = key, addr
    NAMES[addr.lower()] = name
    rpc("anvil_setBalance", [addr, hex(10**20)])


def keystore(name: str, password_file: Path) -> Path:
    d = RUN / "keys" / name
    d.mkdir(parents=True)
    sh(["cast", "wallet", "import", "-k", str(d), "--private-key", KEY[name],
        "--unsafe-password", password_file.read_text(), name])
    f = d / name
    data = json.loads(f.read_text())
    data["address"] = ADDR[name][2:].lower()  # the node reads the address field
    f.write_text(json.dumps(data))
    f.chmod(0o600)
    return f


def record(fields: dict, tx_receipt: dict | None = None, block: int | None = None, **extra) -> dict:
    """A step as the demo sent it. A transaction is placed by its receipt; a
    read by the block it was taken at."""
    if tx_receipt is not None:
        block, index = int(tx_receipt["blockNumber"], 16), int(tx_receipt["transactionIndex"], 16)
        extra.setdefault("tx", tx_receipt["transactionHash"])
    else:
        index = None
    r = {"fields": fields, "block": block, "index": index, "seq": len(RECORDS), **extra}
    RECORDS.append(r)
    return r


# --- the run ------------------------------------------------------------------

C: dict[str, str] = {}   # contract addresses


def deploy() -> None:
    def create(path: str, *args) -> str:
        argv = ["forge", "create", "--root", str(ROOT / "contracts"), "--rpc-url", RPC,
                "--private-key", KEY["deployer"], "--broadcast", path]
        if args:
            argv += ["--constructor-args", *args]
        out = sh(argv)
        return next(line.split()[-1] for line in out.splitlines() if line.startswith("Deployed to:"))
    C["RoundClock"] = create("src/clock/RoundClock.sol:RoundClock")
    C["MockUSDC"] = create("src/money/MockUSDC.sol:MockUSDC")
    # The Registry refuses the Broker as a payout address, so it is given the
    # address the Broker will be created at: the deployer's next nonce.
    nonce = int(rpc("eth_getTransactionCount", [ADDR["deployer"], "latest"]), 16)
    broker_at = sh(["cast", "compute-address", ADDR["deployer"], "--nonce", str(nonce + 1)]).split()[-1]
    C["Registry"] = create("src/authority/Registry.sol:Registry", C["RoundClock"], broker_at)
    C["Broker"] = create("src/money/Broker.sol:Broker", C["MockUSDC"], C["Registry"], C["RoundClock"])
    if C["Broker"].lower() != broker_at.lower():
        raise Failed(f"the Broker landed at {C['Broker']}, not {broker_at} as the Registry was told")
    C["Controller"] = create("src/authority/Controller.sol:Controller", C["Registry"], C["RoundClock"], C["Broker"])
    names = {"BondingManager": "Registry", "RoundsManager": "RoundClock", "TicketBroker": "Broker"}
    for legacy, ours in names.items():
        got = call(C["Controller"], "getContract(bytes32)", sh(["cast", "keccak", legacy]))
        if got != int(C[ours], 16):
            raise Failed(f"the Controller does not answer {legacy} with the {ours}")


def current_round(block="latest") -> int:
    return call(C["RoundClock"], "currentRound()", block=block)


def round_started_at() -> int:
    logs = rpc("eth_getLogs", [{"address": C["RoundClock"], "fromBlock": "0x0", "toBlock": "latest",
                                "topics": [sh(["cast", "keccak", "RoundStarted(uint256,uint256,bytes32)"])]}])
    return int(logs[-1]["data"][2:66], 16)


FEE_SETTLED = None


def settlements() -> list[dict]:
    """Every ticket the Broker settled, with what the node sent to redeem it."""
    global FEE_SETTLED
    FEE_SETTLED = FEE_SETTLED or sh(["cast", "keccak", "FeeSettled(uint256,address,address,bytes32,uint256,uint256,uint256,address)"])
    logs = rpc("eth_getLogs", [{"address": C["Broker"], "fromBlock": "0x0", "toBlock": "latest", "topics": [FEE_SETTLED]}])
    out = []
    for log in logs:
        d = log["data"][2:]
        word = lambda i: int(d[64 * i:64 * (i + 1)], 16)  # noqa: E731
        tx = rpc("eth_getTransactionByHash", [log["transactionHash"]])
        ticket = decode_ticket(tx["input"])
        out.append({"round": int(log["topics"][1], 16), "node": "0x" + log["topics"][2][-40:],
                    "payer": "0x" + log["topics"][3][-40:], "hash": "0x" + d[0:64], "gross": word(1),
                    "node_amount": word(2), "network_amount": word(3), "block": int(log["blockNumber"], 16),
                    "index": int(log["transactionIndex"], 16), "tx": log["transactionHash"], "from": tx["from"],
                    "input": tx["input"], **ticket})
    return out


def decode_ticket(data: str) -> dict:
    """redeemWinningTicket((recipient, sender, face, winProb, nonce, randHash, auxData), sig, rand)."""
    if data[:10] != sel("redeemWinningTicket((address,address,uint256,uint256,uint256,bytes32,bytes),bytes,uint256)"):
        raise Failed("a settled ticket was not redeemed by redeemWinningTicket")
    b = bytes.fromhex(data[10:])
    word = lambda at: int.from_bytes(b[at:at + 32], "big")  # noqa: E731
    t = word(0)
    aux_at = t + word(t + 6 * 32)
    aux_len = word(aux_at)
    if aux_len != 64:
        raise Failed("a settled ticket's auxData is not 64 bytes")
    return {"recipient": "0x" + b[t + 12:t + 32].hex(), "sender": "0x" + b[t + 44:t + 64].hex(),
            "face": word(t + 64), "created_round": word(aux_at + 32)}


def name(addr: str) -> str:
    return NAMES[addr.lower()]


def wait_settled(count: int, why: str) -> list[dict]:
    """Mine past the tickets' parameter expiry, then wait for the node to redeem."""
    mine(41)
    end = time.time() + 120
    while time.time() < end:
        s = settlements()
        if len(s) > count:
            raise Failed(f"{why}: the Broker settled {len(s)} tickets, want {count}")
        if len(s) == count:
            return s
        time.sleep(1)
    raise Failed(f"{why}: the node redeemed {len(settlements())} tickets, want {count} (see .cache/demo/run/logs/orchestrator.log)")


def post(url: str, body: dict, headers: dict | None = None) -> tuple[int, str]:
    req = urllib.request.Request(url, data=json.dumps(body).encode(), method="POST",
                                 headers={"content-type": "application/json", **(headers or {})})
    try:
        with urllib.request.urlopen(req, timeout=120) as r:
            return r.status, r.read().decode()
    except urllib.error.HTTPError as e:
        return e.code, e.read().decode()
    except (urllib.error.URLError, ConnectionError) as e:
        return 0, str(e)


ORCH = f"http://127.0.0.1:{PORT['orch']}"
JOB_PATH = "/apps/llm/app/v1/chat/completions"
JOB = {"messages": [{"role": "user", "content": "Name one colour of the sky."}], "max_tokens": 16}


def challenge(payer: str) -> tuple[int, str]:
    return post(ORCH + JOB_PATH, JOB, {"Livepeer-Payer-Address": ADDR[payer]})


def sign(payer: str, body: str) -> tuple[int, str]:
    signer = f"http://127.0.0.1:{PORT['signer_p' if payer == 'P' else 'signer_p2']}"
    return post(signer + "/generate-live-payment", {"orchestrator": json.loads(body)["payment_params"], "type": "fixed"})


def pay(payer: str, signed: str) -> tuple[int, str]:
    s = json.loads(signed)
    return post(ORCH + JOB_PATH, JOB, {"Livepeer-Payer-Address": ADDR[payer],
                                       "Livepeer-Payment": s["payment"], "Livepeer-Segment": s["segCreds"]})


def job(payer: str = "P") -> str:
    code, body = challenge(payer)
    if code != 402:
        raise Failed(f"a job's first request: got HTTP {code} {body[:200]}, want 402 with a payment challenge")
    code, signed = sign(payer, body)
    if code != 200:
        raise Failed(f"the payer's signer: got HTTP {code} {signed[:200]}")
    code, answer = pay(payer, signed)
    if code != 200:
        raise Failed(f"the paid request: got HTTP {code} {answer[:200]}")
    return json.loads(answer)["choices"][0]["message"]["content"].strip().replace("\n", " ")


def fund(payer: str, deposit: int, earmark: int, node: str | None) -> None:
    send(KEY["deployer"], C["MockUSDC"], "mint(address,uint256)", ADDR[payer], deposit + earmark)
    argv = [str(RUN / "bin" / "lp2-fund"), "--rpc-url", RPC, "--keystore-file", str(RUN / "keys" / payer / payer),
            "--keystore-password-file", str(RUN / "pw"), "--controller-address", C["Controller"],
            "--usdc-address", C["MockUSDC"], "--deposit", str(deposit), "--earmark", str(earmark)]
    if node:
        argv += ["--node", ADDR[node]]
    out = sh(argv)
    tx = next(w.rstrip(")") for line in out.splitlines() if line.startswith("funded:") for w in line.split() if w.startswith("0x") and len(w.rstrip(")")) == 66)
    fields = {"action": "fund", "payer": payer, "deposit_micro_usdc": deposit}
    if node:
        fields["node"] = node
    fields["earmark_micro_usdc"] = earmark
    record(fields, receipt(tx))
    if call(C["MockUSDC"], "balanceOf(address)", ADDR[payer]) != 0:
        raise Failed(f"{payer}'s wallet is not empty after funding, so it cannot stand for what was released")


def observe(payer: str, node: str) -> tuple[int, int]:
    """What the node is shown: the two reads it makes before it accepts a payer."""
    b = block_number()
    deposit = call(C["Broker"], "getSenderInfo(address)", ADDR[payer], block=b)
    claimable = call(C["Broker"], "claimableReserve(address,address)", ADDR[payer], ADDR[node], block=b)
    record({"action": "observe", "payer": payer, "node": node}, block=b, shown=(deposit, claimable))
    return deposit, claimable


def request_release(payer: str, node: str | None, amount: int) -> dict:
    r = send(KEY[payer], C["Broker"], "requestRelease(address,uint256)", ADDR[node] if node else ZERO, amount)
    fields = {"action": "request_release", "payer": payer}
    if node:
        fields["node"] = node
    fields["amount_micro_usdc"] = amount
    record(fields, r)
    return r


def release(payer: str, node: str | None) -> dict:
    r = send(KEY[payer], C["Broker"], "release(address)", ADDR[node] if node else ZERO)
    fields = {"action": "release", "payer": payer}
    if node:
        fields["node"] = node
    record(fields, r)
    return r


def junk_registrations(n: int) -> None:
    """n addresses nobody holds a key for each register: anvil sends as them."""
    addrs = ["0x" + os.urandom(20).hex() for _ in range(n)]
    for i, a in enumerate(addrs, 1):
        NAMES[a] = f"J{i:03d}"
    setup = [("anvil_setBalance", [a, hex(10**18)]) for a in addrs] + [("anvil_impersonateAccount", [a]) for a in addrs]
    for a in rpc_batch(setup):
        if "error" in a:
            raise Failed(f"junk setup: {a['error']}")
    sent = rpc_batch([("eth_sendTransaction", [{"from": a, "to": C["Registry"], "data": sel("register()"), "gas": hex(200000)}])
                      for a in addrs])
    hashes = []
    for a, s in zip(addrs, sent):
        if "error" in s:
            raise Failed(f"junk registration: {s['error']}")
        hashes.append(s["result"])
    end = time.time() + 60
    receipts = []
    while time.time() < end:
        receipts = rpc_batch([("eth_getTransactionReceipt", [h]) for h in hashes])
        if all(r.get("result") for r in receipts):
            break
        time.sleep(0.5)
    for a, r in zip(addrs, receipts):
        if not r.get("result") or r["result"]["status"] != "0x1":
            raise Failed("a junk registration was not mined")
        record({"action": "register", "node": NAMES[a]}, r["result"])
    if not all(calls([(C["Registry"], "isRegistered(address)", (a,)) for a in addrs])):
        raise Failed("a junk address is not registered")


# --- reconciling against the calculator ---------------------------------------

def assemble(upto_block: int | None = None) -> tuple[list[dict], dict]:
    """Every step so far, in chain order: what the demo sent and each ticket
    the node redeemed (its face and creation round read from the redemption
    transaction). Then every view the case needs, read from the chain."""
    records = [r for r in RECORDS if upto_block is None or r["block"] <= upto_block]
    tickets: dict[str, str] = {}
    for s in settlements():
        if upto_block is not None and s["block"] > upto_block:
            continue
        if s["from"].lower() != ADDR["N"].lower():
            raise Failed(f"ticket {s['hash']} was redeemed by {s['from']}, not the node")
        tid = tickets.setdefault(s["hash"], f"t{len(tickets) + 1}")
        records.append({"fields": {"action": "redeem", "ticket": tid, "payer": name(s["sender"]), "node": name(s["recipient"]),
                                   "created_round": s["created_round"], "face_micro_usdc": s["face"]},
                        "block": s["block"], "index": s["index"], "seq": 10**9 + s["block"], "settled": s})
    for r in records:  # a replayed ticket keeps the id of its first redemption
        if r["fields"].get("ticket", "").startswith("0x"):
            r["fields"]["ticket"] = tickets[r["fields"]["ticket"]]
    blocks = sorted({r["block"] for r in records})
    rounds = dict(zip(blocks, round_batch(blocks)))
    for r in records:
        r["round"] = rounds[r["block"]]
        if "settled" in r and r["settled"]["round"] != r["round"]:
            raise Failed("a FeeSettled round differs from the clock's round at its block")
    ordered = ledgercase.order(records)
    need = ledgercase.views_needed(ledgercase.steps(ordered))
    at = upto_block if upto_block is not None else block_number()
    return ordered, read_views(need, at)


def round_batch(blocks: list[int]) -> list[int]:
    answers = rpc_batch([("eth_call", [{"to": C["RoundClock"], "data": sel("currentRound()")}, hex(b)]) for b in blocks])
    return [int(a["result"], 16) for a in answers]


def read_views(need: dict, block: int) -> dict:
    by_name = {v: k for k, v in NAMES.items()}
    a = by_name.__getitem__
    items = [(C["Broker"], "earmarkOf(address,address)", (a(p), ZERO)) for p in need["payers"]]
    items += [(C["Broker"], "earmarkOf(address,address)", (a(p), a(n))) for p, n in need["earmarks"]]
    wallets = sorted(set(need["wallets"]) | set(need["payers"]))
    items += [(C["MockUSDC"], "balanceOf(address)", (a(w),)) for w in wallets]
    items += [(C["Broker"], "networkHeld()", ())]
    items += [(C["Broker"], "feesOf(uint256,address)", (int(r), a(n))) for r, n in need["fees"]]
    fee_rounds = sorted({r for r, _ in need["fees"]}, key=int)
    items += [(C["Broker"], "totalFees(uint256)", (int(r),)) for r in fee_rounds]
    got = iter(calls(items, block))
    views = {"deposit": {p: next(got) for p in need["payers"]},
             "earmark": {(p, n): next(got) for p, n in need["earmarks"]},
             "wallet": {w: next(got) for w in wallets}, "network": next(got),
             "fees": {(r, n): next(got) for r, n in need["fees"]},
             "total_fees": {r: next(got) for r in fee_rounds},
             "need": need, "block": block}
    return views


def calculator(case_steps: list[dict]) -> dict:
    from reference import Parameters, calculate
    return ledgercase.strings(calculate("ledger", {"steps": case_steps}, Parameters.from_strings(PARAMS), {}))


ROW_NAMES = {"deposits_micro_usdc": "deposit", "earmarks_micro_usdc": "earmark", "paid_micro_usdc": "wallet",
             "released_micro_usdc": "released to", "network_micro_usdc": "network share held (networkHeld)",
             "fees_micro_usdc": "fees in round", "total_fees_micro_usdc": "all fees in round"}
FAILURES: list[str] = []


def row_order(path: tuple) -> list:
    """Figures in the case's order, numbers as numbers, deposit before earmark."""
    rank = list(ROW_NAMES) + ["observed", "refused"]
    rest = [p.replace("deposit_micro_usdc", "0").replace("claimable_micro_usdc", "1") for p in map(str, path[1:])]
    return [rank.index(path[0])] + [[int(x) if x.isdigit() else x for x in re.split(r"(\d+)", p)] for p in rest]


def reconcile(title: str) -> tuple[list[dict], dict]:
    """Print every figure read from the chain beside the calculator's figure
    for the same steps; record a failure for any that differ."""
    ordered, views = assemble()
    case_steps = ledgercase.steps(ordered)
    chain = ledgercase.expected(ordered, views["need"], views)
    calc = calculator(case_steps)
    flat_chain, flat_calc = ledgercase.flatten(chain), ledgercase.flatten(calc)
    say(f"\n  {title}: {len(case_steps)} steps, chain at block {views['block']}, round {current_round()}")
    say(f"  {'figure (micro-USDC)':<46}{'chain':>14}{'calculator':>14}")
    quiet = 0
    for path in sorted(set(flat_chain) | set(flat_calc), key=row_order):
        got, want = flat_chain.get(path, "absent"), flat_calc.get(path, "absent")
        if path[0] in ("observed", "refused") and path[-1] == "steps":
            continue
        if got == want and (got in ("0", "{}") and str(path[1]).startswith("J")):
            quiet += 1
            continue
        if path[0] == "observed":
            label = f"node shown, {path[1]}: {'deposit' if path[2].startswith('deposit') else 'earmark'}"
        elif path[0] == "refused":
            label = f"refused, {path[1]}"
        elif path[0] in ("fees_micro_usdc",):
            label = f"fees of {path[2]} in round {path[1]}"
        elif path[0] == "total_fees_micro_usdc":
            label = f"all fees in round {path[1]}"
        elif path[0] == "earmarks_micro_usdc":
            label = f"earmark of {path[1]} for {path[2]}" if len(path) > 2 else f"earmarks of {path[1]}"
        elif path[0] == "network_micro_usdc":
            label = ROW_NAMES[path[0]]
        else:
            label = f"{ROW_NAMES[path[0]]} {path[1]}"
        mark = "equal" if got == want else "DIFFERS"
        fmt = lambda v: money(v) if str(v).isdigit() else str(v)  # noqa: E731
        say(f"  {label:<46}{fmt(got):>14}{fmt(want):>14}  {mark}")
        if got != want:
            FAILURES.append(f"{title}: {label}: chain {got}, calculator {want}")
    if quiet:
        say(f"  {'wallets of ' + str(quiet) + ' junk nodes, each':<46}{'0':>14}{'0':>14}  equal")
    custody(title, case_steps, calc, views["block"])
    diffs = ledgercase.differences(chain, calc)
    if diffs:
        say(f"  {len(diffs)} figure(s) differ")
    else:
        say(f"  every figure equal ({len(flat_chain)} figures)")
    return ordered, views


def custody(title: str, case_steps: list[dict], calc: dict, block: int) -> None:
    """The Broker's own USDC, beside what the calculator says it holds: every
    deposit, earmark and network share. And all the USDC there is, beside
    what the demo minted to payers to fund them, so no USDC was made or kept
    anywhere the figures above do not look."""
    broker, supply = calls([(C["MockUSDC"], "balanceOf(address)", (C["Broker"],)),
                            (C["MockUSDC"], "totalSupply()", ())], block)
    held = (sum(int(v) for v in calc["deposits_micro_usdc"].values())
            + sum(int(v) for e in calc["earmarks_micro_usdc"].values() for v in e.values())
            + int(calc["network_micro_usdc"]))
    minted = sum(int(s["deposit_micro_usdc"]) + int(s["earmark_micro_usdc"]) for s in case_steps if s["action"] == "fund")
    for label, got, want, source in (("USDC the Broker holds", broker, held, "calculator"),
                                     ("all USDC in existence", supply, minted, "demo minted")):
        mark = "equal" if got == want else "DIFFERS"
        say(f"  {label:<46}{money(got):>14}{money(want):>14}  {mark} ({source})")
        if got != want:
            FAILURES.append(f"{title}: {label}: chain {got}, {source} {want}")


def check(what: str, got, want) -> None:
    ok = got == want
    say(f"  {'ok  ' if ok else 'FAIL'} {what}: {got}" + ("" if ok else f", want {want}"))
    if not ok:
        FAILURES.append(f"{what}: got {got}, want {want}")


# --- the demo -----------------------------------------------------------------

def main() -> int:
    global LOG
    shutil.rmtree(RUN, ignore_errors=True)
    (RUN / "logs").mkdir(parents=True)
    LOG = open(RUN / "demo.log", "w")
    started = time.time()
    say("Stage 2 demo (S-09 section 1): the unmodified node paid in mock USDC on a fresh local chain")
    say(f"Stand-ins, from deployments/stage-2-local.json: {'; '.join(s['stand_in'] for s in MANIFEST['stand_ins'])}.")

    say("\n1. Setting up")
    preflight()
    node_bin = fetch_node()
    model = fetch_model()
    build_ours()
    say(f"  node {MANIFEST['node']['commit'][:12]} (unmodified), model sha256 {MANIFEST['model']['sha256'][:12]}, contracts and programs built")

    price = MANIFEST["price"]
    job_price = int(float(price["job_price_usd"]) * int(price["wei_per_usd"]) + 0.5)
    face = job_price + 1
    demo_case = CASES["ledger-demo"]
    fund_step = demo_case["inputs"]["steps"][1]
    deposit, earmark = int(fund_step["deposit_micro_usdc"]), int(fund_step["earmark_micro_usdc"])
    check("the ticket face the manifest gives (job price + 1) equals ledger-demo's face",
          face, int(demo_case["inputs"]["steps"][2]["face_micro_usdc"]))

    chain = MANIFEST["chain"]
    start("anvil", ["anvil", "--port", str(PORT["chain"]), "--chain-id", str(chain["chain_id"]),
                    "--block-time", str(chain["block_time_seconds"]), "--slots-in-an-epoch", "1"])
    for _ in range(100):
        try:
            block_number()
            break
        except (urllib.error.URLError, ConnectionError, OSError):
            time.sleep(0.1)
    else:
        raise NotRun("the local chain did not start")
    pw = RUN / "pw"
    pw.write_text("pw-" + os.urandom(8).hex())
    pw.chmod(0o600)
    for who in ("deployer", "N", "P", "P2", "keeper", "anyone"):
        new_key(who)
    keys = {who: keystore(who, pw) for who in ("N", "P", "P2", "keeper")}
    deploy()
    (RUN / "addresses.json").write_text(json.dumps({"contracts": C, "accounts": {k: v for k, v in ADDR.items()}}, indent=1))
    say(f"  local chain on {RPC} (chain id {chain['chain_id']}); throwaway keys for the node N, payers P and P2, the keeper")
    say("  contracts: " + ", ".join(f"{k} {v}" for k, v in C.items()))
    check("RoundClock.roundLength() equals the shared examples' round length", call(C["RoundClock"], "roundLength()"),
          int(PARAMS["round_length_blocks"]))
    check("and the manifest's", chain["round_length_blocks"], int(PARAMS["round_length_blocks"]))

    container = f"lp2-demo-llm-{BASE}"
    subprocess.run(["docker", "rm", "-f", container], capture_output=True)
    CONTAINERS.append(container)
    sh(["docker", "run", "-d", "--rm", "--name", container, "-p", f"127.0.0.1:{PORT['model']}:8080",
        "-v", f"{model.parent}:/models:ro", MANIFEST["model"]["server_image"],
        "-m", f"/models/{model.name}", "--host", "0.0.0.0", "--port", "8080", "-t", "4"])
    for _ in range(120):
        try:
            with urllib.request.urlopen(f"http://127.0.0.1:{PORT['model']}/health", timeout=2) as r:
                if r.status == 200:
                    break
        except (urllib.error.URLError, ConnectionError, OSError):
            pass
        time.sleep(1)
    else:
        raise NotRun("the model server did not become healthy")

    orch_dir, rpc_file = RUN / "orchestrator", RUN / "rpc-url"
    orch_dir.mkdir()
    rpc_file.write_text(RPC)
    (orch_dir / "runners.toml").write_text(f"""[[Runners]]
ID = "llm"
RunnerURL = "http://127.0.0.1:{PORT['model']}"
App = "chat"
Mode = "single-shot"
Status = "ready"
Capacity = 4
HealthURL = "http://127.0.0.1:{PORT['model']}/health"
HealthCode = 200
[Runners.PriceInfo]
Price = {price['job_price_usd']}
Currency = "USD"
Unit = "{price['unit']}"
""")
    start("orchestrator", [str(node_bin / "livepeer-orchestrator"), "--config=", "--network", "lp2-demo",
                           "--data-dir", str(orch_dir), "--listen", f"127.0.0.1:{PORT['orch']}",
                           "--metrics-listen", f"127.0.0.1:{PORT['orch_metrics']}",
                           "--runner-config", str(orch_dir / "runners.toml"), "--runner-grants", "127.0.0.1",
                           "--health-grants", f"127.0.0.1:{PORT['model']}",
                           "--keystore-file", str(keys["N"]), "--keystore-password-file", str(pw),
                           "--rpc-url-file", str(rpc_file), "--chain-id", str(chain["chain_id"]),
                           "--controller-address", C["Controller"], "--redeemer-db", str(orch_dir / "payments.sqlite"),
                           "--wei-per-usd", price["wei_per_usd"], "--ticket-face-value", str(face),
                           "--ticket-win-prob", price["ticket_win_prob"]], cwd=orch_dir)
    lim = MANIFEST["signer_limits"]
    for payer, port, metrics in (("P", PORT["signer_p"], PORT["signer_p_metrics"]), ("P2", PORT["signer_p2"], PORT["signer_p2_metrics"])):
        d = RUN / f"signer-{payer}"
        d.mkdir()
        start(f"signer-{payer}", [str(node_bin / "livepeer-signer"), "--config=", "--network", "lp2-demo", "--data-dir", str(d),
                                  "--listen", f"127.0.0.1:{port}", "--metrics-listen", f"127.0.0.1:{metrics}",
                                  "--keystore-file", str(keys[payer]), "--keystore-password-file", str(pw),
                                  "--rpc-url-file", str(rpc_file), "--chain-id", str(chain["chain_id"]),
                                  "--controller-address", C["Controller"], "--wei-per-usd", price["wei_per_usd"],
                                  "--max-hourly-price", lim["max_hourly_price_usd"], "--max-fixed-price", lim["max_fixed_price_usd"],
                                  "--max-ticket-ev", lim["max_ticket_ev"], "--max-batch-ev", lim["max_batch_ev"],
                                  "--orchestrators", ORCH, "--discovery-grants", f"127.0.0.1:{PORT['orch']}"], cwd=d)
    say(f"  model server on port {PORT['model']}; orchestrator for N on {ORCH}; a signer for each payer")

    # --- refusal 1: the node will not serve while its address is unregistered
    say("\n2. Refusal 1: the node will not serve while its address is unregistered")
    code, body = 0, ""
    for _ in range(90):
        code, body = challenge("P")
        if code in (402, 502) and ("payment" in body):
            break
        time.sleep(1)
    check("N is unregistered", not call(C["Registry"], "isRegistered(address)", ADDR["N"]), True)
    say(f"  a job sent to N gets HTTP {code}: {body.strip()[:80]}")
    check("the orchestrator refuses to issue a payment challenge", code, 502)

    r = send(KEY["N"], C["Registry"], "register()")
    record({"action": "register", "node": "N"}, r)
    code, _ = challenge("P")
    say(f"  N registers for free, with no stake (block {int(r['blockNumber'], 16)}); the same job now gets HTTP {code}, a payment challenge.")
    say("  Nothing else changed between the two requests.")
    check("after registering, the node issues a payment challenge", code, 402)

    # --- funding
    say("\n3. The payer funds its account")
    fund("P", deposit, earmark, "N")
    shown = observe("P", "N")
    say(f"  P puts {money(deposit)} micro-USDC (10 USDC) in its deposit and earmarks {money(earmark)} (0.02 USDC) for N, with lp2-fund")
    say(f"  N is shown: deposit {money(shown[0])}, earmark for N {money(shown[1])}")
    start("keeper", [str(RUN / "bin" / "lp2-keeper"), "--rpc-url", RPC, "--keystore-file", str(keys["keeper"]),
                     "--keystore-password-file", str(pw), "--controller-address", C["Controller"], "--poll", "1s"])
    say("  the round keeper starts (it starts each round once 50 blocks have passed)")

    # --- six jobs
    say(f"\n4. Six real jobs through the node, each paid with one ticket of {money(face)} micro-USDC")
    for i in range(1, 7):
        answer = job("P")
        say(f"  job {i}: paid, the model answered: {answer[:60]!r}")
    settled = wait_settled(6, "six jobs")
    say("  the node redeemed each ticket itself, after its parameters expired (40 blocks; the demo mines empty blocks rather than wait):")
    for i, s in enumerate(settled, 1):
        say(f"  ticket {i}: created in round {s['created_round']}, redeemed in round {s['round']}, face {money(s['face'])}: "
            f"node +{money(s['node_amount'])}, network +{money(s['network_amount'])}")
    ordered, views = reconcile("After the six jobs")
    want = demo_case["expected"]
    fees_n = sum(v for (r, n), v in views["fees"].items() if n == "N")
    say("  against S-09 section 1 (ledger-demo in the shared examples):")
    check("P's deposit", views["deposit"]["P"], int(want["deposits_micro_usdc"]["P"]))
    check("P's earmark for N", views["earmark"][("P", "N")], int(want["earmarks_micro_usdc"]["P"]["N"]))
    check("N's wallet", views["wallet"]["N"], int(want["paid_micro_usdc"]["N"]))
    check("network share held", views["network"], int(want["network_micro_usdc"]))
    check("N's fee records across the rounds redeemed in", fees_n, sum(int(v["N"]) for v in want["fees_micro_usdc"].values()))

    # --- refusal 3: a ticket sent a second time
    say("\n5. Refusal 3: the contract refuses a ticket sent a second time")
    first = settled[0]
    data = first["input"]
    answer = rpc_batch([("eth_call", [{"from": ADDR["anyone"], "to": C["Broker"], "data": data}, "latest"])])[0]
    revert = (answer.get("error") or {}).get("data", "")
    code_name = next((c for c in VECTORS["codes"] if revert[:10] == sel(f"{c}()")), revert[:10] or "accepted")
    before = call(C["Broker"], "networkHeld()")
    r = send(KEY["anyone"], C["Broker"], data, gas=1_000_000)
    record({"action": "redeem", "ticket": first["hash"], "payer": "P", "node": "N",
            "created_round": first["created_round"], "face_micro_usdc": first["face"]}, r, code=code_name)
    say(f"  ticket 1's redemption, sent again by another account, block {int(r['blockNumber'], 16)}: {'reverted' if r['status'] == '0x0' else 'ACCEPTED'} with {code_name}")
    check("the second redemption is refused on chain", r["status"], "0x0")
    check("its code", code_name, "TICKET_USED")
    check("the network share did not move", call(C["Broker"], "networkHeld()"), before)

    # --- refusal 2: a payer that has set nothing aside for the node
    say("\n6. Refusal 2: the node refuses a payer that has set nothing aside for it")
    fund("P2", deposit, 0, None)
    shown = observe("P2", "N")
    say(f"  P2 funds a deposit of {money(deposit)} and earmarks nothing; N is shown deposit {money(shown[0])}, earmark {money(shown[1])}")
    code, body = challenge("P2")
    check("the orchestrator issues P2 a payment challenge", code, 402)
    code, signed = sign("P2", body)
    say(f"  P2's own signer (the node's signer program) will not sign: HTTP {code} {signed.strip()[:60]}")
    check("P2's signer refuses", code, 400)
    check("because P2's funds for N are unavailable", "payer funds unavailable" in signed, True)
    say("  the orchestrator makes the same check itself. P2 earmarks for N, its signer signs a payment,")
    say("  and P2 asks for the earmark back before sending it:")
    fund("P2", 0, earmark, "N")
    code, body = challenge("P2")
    check("the orchestrator issues P2 a payment challenge", code, 402)
    code, signed = sign("P2", body)
    check("P2's signer signs while the earmark is there", code, 200)
    request_release("P2", "N", earmark)
    shown = observe("P2", "N")
    say(f"  N is now shown for P2: deposit {money(shown[0])}, earmark {money(shown[1])}")
    code, answer = pay("P2", signed)
    say(f"  the orchestrator answers the paid request: HTTP {code} {answer.strip()[:60]}")
    check("the node refuses the payment", code, 400)
    check("because the earmark it is shown is 0", "claimable reserve is unavailable" in answer, True)
    reconcile("After the three refusals")

    # --- 999 junk registrations
    say(f"\n7. A paid job after {JUNK} junk registrations")
    junk_registrations(JUNK)
    say(f"  {JUNK} addresses register (anvil sends as them, since nobody holds their keys)")
    answer = job("P")
    settled = wait_settled(7, "the job after the junk registrations")
    s7, s1 = settled[6], settled[0]
    say(f"  job 7: paid, the model answered {answer[:50]!r}; ticket redeemed in round {s7['round']}: node +{money(s7['node_amount'])}, network +{money(s7['network_amount'])}")
    check("job 7 moved what job 1 moved (gross, node, network)", (s7["gross"], s7["node_amount"], s7["network_amount"]),
          (s1["gross"], s1["node_amount"], s1["network_amount"]))
    reconcile(f"After {JUNK} registrations and job 7")

    # --- the keeper stopped for five round lengths
    length = int(PARAMS["round_length_blocks"])
    say(f"\n8. A job with the keeper stopped for five round lengths ({5 * length} blocks)")
    stop("keeper")
    round_before, started_at = current_round(), round_started_at()
    mine(5 * length)
    say(f"  keeper stopped; round {round_before} started at block {started_at}; the chain is now at block {block_number()}")
    answer = job("P")
    settled = wait_settled(8, "the job with the keeper stopped")
    s8 = settled[7]
    say(f"  job 8: paid, the model answered {answer[:50]!r}; ticket created in round {s8['created_round']}, redeemed in round {s8['round']} at block {s8['block']}")
    check("no round started meanwhile", current_round(), round_before)
    check("the ticket was paid in full", s8["gross"], face)
    check("the round had lasted at least five round lengths when it was paid", s8["block"] - started_at >= 5 * length, True)
    start("keeper", [str(RUN / "bin" / "lp2-keeper"), "--rpc-url", RPC, "--keystore-file", str(keys["keeper"]),
                     "--keystore-password-file", str(pw), "--controller-address", C["Controller"], "--poll", "1s"])
    for _ in range(30):
        if current_round() > round_before:
            break
        time.sleep(1)
    say(f"  the keeper restarts and starts round {current_round()}: one round, none skipped")
    check("the next round is one more", current_round(), round_before + 1)
    reconcile("After the job with the keeper stopped")

    # --- a release requested right after a job
    say("\n9. A release the payer requests right after a job")
    answer = job("P")
    dep = call(C["Broker"], "earmarkOf(address,address)", ADDR["P"], ZERO)
    ear = call(C["Broker"], "earmarkOf(address,address)", ADDR["P"], ADDR["N"])
    r1 = request_release("P", None, dep)
    r2 = request_release("P", "N", ear)
    shown = observe("P", "N")
    say(f"  job 9 paid (the model answered {answer[:40]!r}); P at once asks for its whole deposit ({money(dep)}) and earmark ({money(ear)}) back")
    say(f"  N is now shown: deposit {money(shown[0])}, earmark {money(shown[1])}; it holds job 9's ticket")
    nh = call(C["MockUSDC"], "balanceOf(address)", ADDR["N"])
    settled = wait_settled(9, "the job before the release request")
    s9 = settled[8]
    say(f"  the node redeems job 9's ticket in block {s9['block']}, after the requests (blocks {int(r1['blockNumber'], 16)} and {int(r2['blockNumber'], 16)}):"
        f" gross {money(s9['gross'])}, node +{money(s9['node_amount'])}, network +{money(s9['network_amount'])}")
    check("the requests came before the redemption", int(r2["blockNumber"], 16) < s9["block"], True)
    check("the job is paid in full", s9["gross"], face)
    check("N's wallet rose by its half", call(C["MockUSDC"], "balanceOf(address)", ADDR["N"]) - nh, s9["node_amount"])
    shown = observe("P", "N")
    ready = words(C["Broker"], "earmarkOf(address,address)", ADDR["P"], ADDR["N"])[2]
    say(f"  after it, N is shown deposit {money(shown[0])}, earmark {money(shown[1])}; the payer may release from round {ready}")
    while current_round() < ready:
        r0 = current_round()
        mine(length)
        for _ in range(30):
            if current_round() > r0:
                break
            time.sleep(1)
        else:
            raise Failed("the keeper did not start the next round")
    release("P", "N")
    release("P", None)
    say(f"  round {current_round()}: P releases both and receives {money(call(C['MockUSDC'], 'balanceOf(address)', ADDR['P']))} micro-USDC")
    observe("P", "N")
    ordered, views = reconcile("At the end of the run")

    # --- the run as a ledger case, reproduced by the calculator
    say("\n10. The run as a ledger case, reproduced by the calculator")
    scan(ordered)
    the_case = ledgercase.case("ledger-demo-run", ordered, views["need"], views)
    out = RUN / "ledger-case.json"
    out.write_text(json.dumps(ledgercase.document(VECTORS, the_case), indent=1) + "\n")
    done = subprocess.run([str(ROOT / "calculator" / "check"), str(out)], capture_output=True, text=True)
    say(f"  wrote {out.relative_to(ROOT)}: {len(the_case['inputs']['steps'])} steps, as sent and as the chain shows them")
    for line in done.stdout.strip().splitlines()[-2:]:
        say(f"  ./calculator/check {out.relative_to(ROOT)}: {line[:150]}{' ...' if len(line) > 150 else ''}")
    check("the calculator reproduces the run's case", done.returncode, 0)

    say(f"\nTook {time.time() - started:.0f} s. Logs, addresses and the case are in {RUN.relative_to(ROOT)}/.")
    if FAILURES:
        say(f"DEMO FAILED: {len(FAILURES)} check(s) failed:")
        for f in FAILURES:
            say(f"  {f}")
        return 1
    say("DEMO PASSED: six jobs paid, three refusals seen, every balance read from the chain equals the calculator's.")
    return 0


def scan(ordered: list[dict]) -> None:
    """Every transaction to the Registry or the Broker is a step of the case."""
    known = {r["tx"].lower() for r in RECORDS if r.get("tx")} | {r["settled"]["tx"].lower() for r in ordered if "settled" in r}
    blocks = rpc_batch([("eth_getBlockByNumber", [hex(b), True]) for b in range(block_number() + 1)])
    targets = {C["Registry"].lower(), C["Broker"].lower()}
    stray = [t["hash"] for b in blocks for t in b["result"]["transactions"]
             if (t.get("to") or "").lower() in targets and t["hash"].lower() not in known]
    check("every transaction to the Registry or the Broker is a step of the case", stray, [])


if __name__ == "__main__":
    def interrupted(*_):
        raise KeyboardInterrupt
    signal.signal(signal.SIGTERM, interrupted)
    code = 2
    try:
        code = main()
    except NotRun as e:
        say(f"DEMO NOT RUN: {e}")
        code = 2
    except Failed as e:
        say(f"DEMO FAILED: {e}")
        code = 1
    except KeyboardInterrupt:
        say("DEMO interrupted")
        code = 2
    finally:
        signal.signal(signal.SIGINT, signal.SIG_IGN)  # a second Ctrl-C must not stop the cleanup
        cleanup()
    sys.exit(code)
