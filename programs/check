#!/bin/sh
# The helper programs' fast check: vet, then run every test. ./dev runs it
# from this folder. Exit 0 passed, 1 failed, 2 could not run.
set -u
cd "$(dirname "$0")"
command -v go >/dev/null 2>&1 || { echo "go is not installed (./dev doctor)"; exit 2; }
go vet ./... || exit 1
go test ./... || exit 1
