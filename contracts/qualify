#!/bin/sh
# The contracts' heavy check, run by ./dev qualify when a stage closes:
#   1. long invariant and fuzz runs over test-qualify/ (the qualify profile
#      in foundry.toml), with a fixed seed so a failure can be replayed;
#      LP2_QUALIFY_SEED=<n> searches with another seed;
#   2. static analysis: contracts/slither, at the version tools/versions
#      pins; without it this check is not_run, never passed;
#   3. seeded errors (mutations.py): each must turn a check red.
# Exit 0 passed, 1 failed, 2 could not run.
set -u
command -v python3 >/dev/null 2>&1 || { echo "python3 is not installed (./dev doctor)"; exit 2; }
cd "$(dirname "$0")"
command -v forge >/dev/null 2>&1 || { echo "forge is not installed (./dev doctor)"; exit 2; }
mkdir -p cache
# Forge takes settings from any FOUNDRY_ or DAPP_ variable (test filters,
# FOUNDRY_SKIP, fuzz runs, the output folder...). None comes from the
# caller: the whole suite runs as foundry.toml sets it up, and this script
# sets what it needs itself. So every program here that runs forge is
# started by run_clean:
#   run_clean [NAME=value...] <program> [argument...]
# runs <program> with no FOUNDRY_ or DAPP_ variable from the caller, the
# NAME=value settings given added, and every other variable as the caller
# set it. python3 reads the environment by name, so no value, however many
# lines it spans or whatever it holds, is taken for a variable. sh keeps no
# variable whose name it cannot hold (one with a space, say); on Linux,
# python3 adds those back from what this script was started with. The
# program's exit status comes back unchanged; 2 (not_run) when python3
# stopped before starting it, so a python3 that fails is never a result.
run_clean() {
    rm -f cache/.started && [ ! -e cache/.started ] ||
        { echo "$*: not_run (cache/.started cannot be removed)"; return 2; }
    python3 -I -S -c 'import os, re, sys
try:
    shell, started, args = sys.argv[1], sys.argv[2], sys.argv[3:]
    settings = {}
    while args and re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*=.*", args[0], re.S):
        name, value = args.pop(0).split("=", 1)
        settings[os.fsencode(name)] = os.fsencode(value)
    env = dict(os.environb)
    try:
        with open(f"/proc/{shell}/environ", "rb") as f:
            for entry in f.read().split(b"\0"):
                name, sep, value = entry.partition(b"=")
                if name and sep and name not in env and not re.fullmatch(rb"[A-Za-z_][A-Za-z0-9_]*", name):
                    env[name] = value
    except OSError:
        pass
    env = {k: v for k, v in env.items() if not k.startswith((b"FOUNDRY_", b"DAPP_"))}
    env.update(settings)
    open(started, "w").close()
    os.execvpe(args[0], args, env)
except BaseException as e:
    print(f"{sys.argv[3:]}: not_run (could not start it without FOUNDRY_ and DAPP_ variables: {e!r})", file=sys.stderr)
sys.exit(2)' "$$" cache/.started "$@"
    s=$?
    [ -e cache/.started ] ||
        { echo "$*: not_run (python3 exited $s before starting it)"; return 2; }
    return $s
}
failed=0

echo "== invariant and fuzz runs (profile qualify)"
start=$(date +%s)
[ -n "${LP2_QUALIFY_SEED:-}" ] && set -- --fuzz-seed "$LP2_QUALIFY_SEED"
# The output is kept (under the ignored cache) to check the runs happened:
# forge exits 0 when it finds no tests.
mkdir -p cache/qualify
log=cache/qualify/runs.log
{ run_clean FOUNDRY_PROFILE=qualify forge test "$@"; echo $? >"$log.code"; } 2>&1 | tee "$log"
case "$(cat "$log.code")" in
    0) ;;
    2) failed=2 ;;  # run_clean, or forge itself, could not start the runs
    *) failed=1 ;;
esac
if ! grep -q 'MoneyInvariants invariants (runs: [1-9]' "$log"; then
    echo "runs: not_run (no invariant campaign ran)"
    [ $failed -eq 0 ] && failed=2
fi
echo "runs: $(( $(date +%s) - start ))s"

echo "== static analysis (contracts/slither)"
run_clean ./slither
case $? in
    0) ;;
    2) [ $failed -eq 0 ] && failed=2 ;;
    *) failed=1 ;;
esac

echo "== seeded errors"
start=$(date +%s)
run_clean python3 mutations.py
case $? in
    0) ;;
    2) echo "seeded errors: could not run"; [ $failed -eq 0 ] && failed=2 ;;
    *) failed=1 ;;
esac
echo "seeded errors: $(( $(date +%s) - start ))s"

[ $failed -eq 0 ] && echo "contracts/qualify: passed"
exit $failed
