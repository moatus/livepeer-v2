#!/bin/sh
# The contracts' heavy check, run by ./dev qualify when a stage closes:
#   1. long invariant and fuzz runs over test-qualify/ (the qualify profile
#      in foundry.toml), with a fixed seed so a failure can be replayed;
#      LP2_QUALIFY_SEED=<n> searches with another seed;
#   2. static analysis: contracts/slither, at the version tools/versions
#      pins; without it this check is not_run, never passed;
#   3. seeded errors (mutations.py): each must turn a check red.
# Exit 0 passed, 1 failed, 2 could not run.
set -u
cd "$(dirname "$0")"
# Forge takes settings from any FOUNDRY_ or DAPP_ variable (test filters,
# FOUNDRY_SKIP, fuzz runs, the output folder...). None comes from the
# caller: the whole suite runs as foundry.toml sets it up, and this script
# sets what it needs itself.
for v in $(env | sed -nE 's/^((FOUNDRY|DAPP)_[A-Za-z0-9_]*)=.*/\1/p'); do unset "$v"; done
command -v forge >/dev/null 2>&1 || { echo "forge is not installed (./dev doctor)"; exit 2; }
command -v python3 >/dev/null 2>&1 || { echo "python3 is not installed (./dev doctor)"; exit 2; }
failed=0

echo "== invariant and fuzz runs (profile qualify)"
start=$(date +%s)
[ -n "${LP2_QUALIFY_SEED:-}" ] && set -- --fuzz-seed "$LP2_QUALIFY_SEED"
# The output is kept (under the ignored cache) to check the runs happened:
# forge exits 0 when it finds no tests.
mkdir -p cache/qualify
log=cache/qualify/runs.log
{ FOUNDRY_PROFILE=qualify forge test "$@"; echo $? >"$log.code"; } 2>&1 | tee "$log"
[ "$(cat "$log.code")" = 0 ] || failed=1
if ! grep -q 'MoneyInvariants invariants (runs: [1-9]' "$log"; then
    echo "runs: not_run (no invariant campaign ran)"
    [ $failed -eq 0 ] && failed=2
fi
echo "runs: $(( $(date +%s) - start ))s"

echo "== static analysis (contracts/slither)"
./slither
case $? in
    0) ;;
    2) [ $failed -eq 0 ] && failed=2 ;;
    *) failed=1 ;;
esac

echo "== seeded errors"
start=$(date +%s)
python3 mutations.py
case $? in
    0) ;;
    2) echo "seeded errors: could not run"; [ $failed -eq 0 ] && failed=2 ;;
    *) failed=1 ;;
esac
echo "seeded errors: $(( $(date +%s) - start ))s"

[ $failed -eq 0 ] && echo "contracts/qualify: passed"
exit $failed
