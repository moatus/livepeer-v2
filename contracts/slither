#!/usr/bin/env python3
"""Static analysis of the contracts with slither, at the version
tools/versions pins. Every finding is either fixed or listed, with the
reason it is accepted, in slither.accepted; a finding not listed fails the
check, and so does a listed one slither no longer reports.

The workflow .github/workflows/slither.yml runs it when the contracts
change, and ./dev qualify runs it through contracts/qualify. Exit 0 passed;
1 failed: a finding neither fixed nor listed, or a listed one no longer
reported; 2 could not run: slither missing, at another version, or
stopping before it wrote its report (never a pass, never a finding)."""
import json
import re
import shutil
import subprocess
import sys
import tempfile
from collections import Counter
from pathlib import Path

HERE = Path(__file__).resolve().parent
ACCEPTED = HERE / "slither.accepted"


def pinned() -> str:
    for line in (HERE.parent / "tools" / "versions").read_text().splitlines():
        if line.startswith("SLITHER_VERSION="):
            return line.split("=", 1)[1].strip()
    raise SystemExit("tools/versions pins no SLITHER_VERSION")


def key(finding: dict) -> str:
    """The detector and the whole of slither's description, one line per
    part joined by " | ", without file paths and line numbers: the
    contract and function, the call or event, and the calling path where
    slither gives one. Moving code does not change it."""
    lines = (re.sub(r" \([^()]*#\d+(-\d+)?\)", "", line).strip()
             for line in finding["description"].strip().splitlines())
    return f"{finding['check']}: " + " | ".join(line for line in lines if line)


def parse_accepted(text: str) -> list[tuple[str, str]]:
    """slither.accepted: a finding's key, then its reason, indented. A
    finding slither reports twice is listed twice."""
    out = []
    for n, line in enumerate(text.splitlines(), 1):
        if not line.strip() or line.startswith("#"):
            continue
        if line[0].isspace():
            if not out or out[-1][1]:
                raise SystemExit(f"slither.accepted:{n}: one reason line follows each finding")
            out[-1] = (out[-1][0], line.strip())
        else:
            out.append((line.strip(), ""))
    missing = [k for k, reason in out if not reason]
    if missing:
        raise SystemExit(f"slither.accepted: no reason given for {missing[0]}")
    return out


def compare(findings: list[dict], accepted: list[tuple[str, str]]):
    """The keys found more often than they are listed (new), and those
    listed more often than they are found (stale), each as (key, found,
    listed)."""
    found = Counter(key(f) for f in findings)
    listed = Counter(k for k, _ in accepted)
    new = [(k, found[k], listed[k]) for k in sorted(found) if found[k] > listed[k]]
    stale = [(k, found[k], listed[k]) for k in sorted(listed) if listed[k] > found[k]]
    return new, stale


def main() -> int:
    want = pinned()
    if not shutil.which("slither"):
        print(f"static analysis: not_run (slither is not installed; tools/setup slither installs {want})")
        return 2
    probe = subprocess.run(["slither", "--version"], capture_output=True, text=True)
    have = probe.stdout.strip()
    if probe.returncode != 0:
        print(f"static analysis: not_run (slither --version exited {probe.returncode}; tools/setup slither)")
        return 2
    if have != want:
        print(f"static analysis: not_run (slither is {have or 'unknown'}, tools/versions pins {want})")
        return 2
    if not shutil.which("forge"):
        print("static analysis: not_run (forge is not installed; ./dev doctor)")
        return 2

    # slither runs `forge clean` before it builds, so it gets a copy of the
    # sources: the checkout's build output and qualify cache are left alone.
    with tempfile.TemporaryDirectory() as tmp:
        work = Path(tmp) / "contracts"
        work.mkdir()
        shutil.copy(HERE / "foundry.toml", work)
        for folder in ("src", "interfaces"):
            shutil.copytree(HERE / folder, work / folder)
        report = Path(tmp) / "report.json"
        done = subprocess.run(["slither", ".", "--foundry-out-directory", "out", "--json", str(report)],
                              cwd=work, capture_output=True, text=True)
        try:
            data = json.loads(report.read_text())
        except (OSError, ValueError):
            data = {}
        if not isinstance(data, dict) or data.get("success") is not True:
            print((done.stdout + done.stderr).strip()[-3000:])
            print(f"static analysis: not_run (slither exited {done.returncode} without a finished report)")
            return 2
    findings = (data.get("results") or {}).get("detectors", [])

    new, stale = compare(findings, parse_accepted(ACCEPTED.read_text()))
    for k, found, listed in new:
        print(f"NEW      {k}\n         (found {found}, accepted {listed}); slither says:")
        for f in findings:
            if key(f) == k:
                print(f"[{f['impact']}] {f['description'].strip()}\n")
    for k, found, listed in stale:
        print(f"STALE    {k}\n         (found {found}, accepted {listed}): remove what slither no longer reports")
    extra = sum(found - listed for _, found, listed in new)
    print(f"slither {have}: {len(findings)} finding(s), {len(findings) - extra} accepted in "
          f"slither.accepted, {extra} new, {sum(listed - found for _, found, listed in stale)} stale")
    if new or stale:
        print("static analysis: FAILED (fix each new finding, or list it with its reason in slither.accepted)")
        return 1
    return 0


def not_run(kind, value, tb):
    # This script stopping is a check that did not run; exit 1 is only for
    # a finding.
    import traceback
    traceback.print_exception(kind, value, tb)
    print("static analysis: not_run (contracts/slither stopped; see above)")
    sys.exit(2)


if __name__ == "__main__":
    sys.excepthook = not_run
    sys.exit(main())
