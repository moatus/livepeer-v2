#!/bin/sh
# The contracts' fast check: layout, then build and run every test, then
# compare each contract's compiled ABI with its interface file. ./dev runs it from this
# folder. Exit 0 passed, 1 failed, 2 could not run.
set -u
command -v python3 >/dev/null 2>&1 || { echo "python3 is not installed (./dev doctor)"; exit 2; }
cd "$(dirname "$0")"
command -v forge >/dev/null 2>&1 || { echo "forge is not installed (./dev doctor)"; exit 2; }
mkdir -p cache
# Every program that runs forge is started by run_clean, with no FOUNDRY_ or
# DAPP_ variable from the caller: see contracts/run-clean.
run_clean() {
    started=$(mktemp -d) || { echo "$*: not_run (mktemp could not make a folder)"; return 2; }
    python3 -I -S run-clean "$started/started" "$@"
    s=$?
    [ -e "$started/started" ] || { echo "$*: not_run (python3 exited $s before starting it)"; s=2; }
    rm -rf -- "$started"
    return $s
}
# Every contract and test laid out as forge fmt lays it out (foundry.toml,
# [fmt]; interfaces/ is left out). forge fmt exits 1 both for a layout that
# differs and for a file it could not read, so a difference is exit 1 with
# a diff and no error; anything else is a formatter that did not run.
run_clean forge fmt --check src test test-qualify >cache/fmt.out 2>cache/fmt.err
code=$?
cat cache/fmt.out cache/fmt.err
if [ $code -ne 0 ]; then
    if [ $code -eq 1 ] && [ ! -s cache/fmt.err ] && grep -q '^Diff in ' cache/fmt.out; then
        echo "forge fmt: not laid out as forge fmt lays it out (forge fmt <file> fixes it)"
        exit 1
    fi
    echo "forge fmt: not_run (it exited $code without a layout difference; see above)"
    exit 2
fi
# forge test exits 1 when a test fails or the code does not compile, and
# also when forge itself stops (an output folder it cannot write, say). So
# exit 1 needs a failing test or the compiler's error in the output; any
# other failure is a check that did not run.
run_clean forge test >cache/test.out 2>&1
code=$?
cat cache/test.out
if [ $code -ne 0 ]; then
    grep -qE '^\[FAIL|Compiler run failed' cache/test.out && exit 1
    echo "forge test: not_run (forge exited $code without a failing test or a compiler error; see above)"
    exit 2
fi
# forge exits 0 when no test matches: a check that ran nothing.
grep -q '^\[PASS' cache/test.out || { echo "forge test: not_run (no test ran)"; exit 2; }
python3 -m unittest -q test_mutations || exit 1

# The reward maths (rulebook v2). Every function in src/math/ is declared
# pure in a library, so the compiler refuses one that reads or changes
# state. And C(r), for every residue r below 840 and for r = 840, 841 and
# 1,680, is R-05's exact floor: the largest c with
# c^840 x 2^r <= EmissionBase^840, held to that inequality here in exact
# integers. EmissionBase and the half-life are read from the shared examples.
run_clean python3 - <<'EOF'
import glob, json, re, subprocess, sys

# A forge that stops, or prints no report, is a check that did not run: exit
# 2. Exit 1 is only for a finding.
def not_run(kind, value, tb):
    print(f"maths: not_run ({value!r})")
    sys.exit(2)
sys.excepthook = not_run

failed = False
for path in sorted(glob.glob("src/math/**/*.sol", recursive=True)):
    text = re.sub(r"//[^\n]*|/\*.*?\*/", "", open(path).read(), flags=re.S)
    for kind in re.findall(r"\b(contract|interface|abstract)\b", text):
        print(f"maths: {path} declares a {kind}; reward maths is a library")
        failed = True
    for head in re.findall(r"\bfunction\b[^{;]*", text):
        if not re.search(r"\bpure\b", head):
            name = head.split("(")[0].split()[-1]
            print(f"maths: {path} {name} is not pure")
            failed = True

v = json.load(open("../vectors/october-main-text-v2.json"))["parameters"]
base, half = int(v["emission_base_wei"]), int(v["emission_half_life_rounds"])
run = subprocess.run(["forge", "test", "--match-test", "test_ceiling_residues", "--json", "-vv"],
                     capture_output=True, text=True)
if run.returncode != 0:
    print(f"maths: not_run (the residue test exited {run.returncode})\n{run.stderr[-600:]}")
    sys.exit(2)
logs = [line for suite in json.loads(run.stdout).values()
        for result in suite["test_results"].values() for line in result["decoded_logs"]]
got = {}
for line in logs:
    m = re.fullmatch(r"C\((\d+)\): (\d+)", line)
    if m:
        got[int(m.group(1))] = int(m.group(2))
    elif line.startswith("gas max: "):
        gas = line[len("gas max: "):]
want = list(range(half)) + [half, half + 1, 2 * half]
if sorted(got) != want:
    print(f"maths: the residue test printed {len(got)} ceilings, not {len(want)}")
    failed = True
top = base ** half
wrong = [r for r in want if r in got and not (got[r] ** half << r <= top < (got[r] + 1) ** half << r)]
for r in wrong:
    print(f"maths: C({r}) = {got[r]} is not the exact floor")
failed = failed or bool(wrong)
if not failed:
    print(f"maths: every function pure; C(r) exact for {len(want)} rounds; costliest {gas} gas")
sys.exit(1 if failed else 0)
EOF
case $? in
    0) ;;
    1) exit 1 ;;
    *) exit 2 ;;
esac

# Each deployed contract and the interface file that declares its public
# shape. The two ABIs must hold the same functions, events and errors, with
# the same types, indexed flags and mutability. The constructor is not
# public shape; pure counts as view, since a caller cannot tell them apart.
# Position is meaning, and equal types cannot tell two positions apart, so
# names are compared too: an event's or an error's parameters and a
# struct's fields by name and order. A function's parameter names are the
# contract's own (a public mapping's getter cannot name its own), so there
# a contract fails only by giving a parameter the name its interface gives
# another position: two equal-typed parameters swapped.
run_clean python3 - <<'EOF'
import json, subprocess, sys

# A forge inspect that stops is a check that did not run: exit 2. Exit 1 is
# only for an ABI that differs.
def not_run(kind, value, tb):
    print(f"abi: not_run ({value!r})")
    sys.exit(2)
sys.excepthook = not_run

PAIRS = [("Controller", "IController"), ("Registry", "IRegistryV2"), ("RoundClock", "IRoundClock"),
         ("Broker", "ITicketBrokerV2"), ("MockUSDC", "IMockUSDC"), ("StakeLedger", "IStakeLedger"),
         ("TestLPT", "ITestLPTV2"), ("Claims", "IClaims"), ("Scores", "IScores"),
         ("Buyback", "IBuyback"), ("TestPool", "ITestPool"), ("FixedBuybackValues", "IBuybackValues")]

# Declared in an interface but built by a later phase, which removes its
# line here when it builds them. Nothing else may be missing.
LATER = {}

# A struct's fields always carry their names; top-level parameters only
# where named is set (events and errors).
def params(ps, named=True):
    return [[p["type"], p.get("internalType"), p.get("indexed"), p.get("name") if named else None,
             params(p.get("components", []))] for p in ps]

def inspect(name):
    return json.loads(subprocess.run(["forge", "inspect", name, "abi", "--json"],
                                     check=True, capture_output=True, text=True).stdout)

def shape(abi, name):
    out = set()
    for e in abi:
        if e["type"] == "constructor" or e.get("name") in LATER.get(name, ()):
            continue
        mutability = "view" if e.get("stateMutability") == "pure" else e.get("stateMutability")
        named = e["type"] != "function"
        out.add(json.dumps([e["type"], e.get("name"), params(e.get("inputs", []), named),
                            params(e.get("outputs", []), named), mutability, e.get("anonymous")]))
    return out

# The parameters of each function the two declare alike that the contract
# names as its interface names another position. A trailing or leading
# underscore is the contract's own spelling.
def swapped(cabi, iabi):
    def key(e):
        return (e.get("name"), tuple(p["type"] for p in e.get("inputs", [])))
    mine = {key(e): e for e in iabi if e["type"] == "function"}
    out = []
    for e in cabi:
        theirs = mine.get(key(e)) if e["type"] == "function" else None
        for part in ("inputs", "outputs") if theirs else ():
            c = [p.get("name", "").strip("_") for p in e.get(part, [])]
            i = [p.get("name", "").strip("_") for p in theirs.get(part, [])]
            out += [f"{e['name']} {part[:-1]} {k} is named {n}, which is {part[:-1]} {i.index(n)} there"
                    for k, n in enumerate(c) if n and n in i and i[k] != n]
    return out

failed = False
for contract, interface in PAIRS:
    cabi, iabi = inspect(contract), inspect(interface)
    c, i = shape(cabi, contract), shape(iabi, interface)
    swaps = swapped(cabi, iabi)
    for s in swaps:
        print(f"abi: {contract} swaps against {interface}: {s}")
    for e in sorted(c - i):
        print(f"abi: {contract} has, {interface} does not declare: {e}")
    for e in sorted(i - c):
        print(f"abi: {interface} declares, {contract} does not have: {e}")
    failed = failed or c != i or bool(swaps)
    if c == i and not swaps:
        later = sorted(LATER.get(interface, ()))
        print(f"abi: {contract} equals {interface}" + (f", less {', '.join(later)}" if later else ""))

# Interfaces a freeze declares and no contract implements yet, each with its
# whole surface as the spec gives it (S-10). The phase that builds the
# contract moves it to PAIRS and removes it here. Mutability is
# compared exactly: a contract cannot implement a pure declaration with a
# view. Every named parameter, output and struct field is written with its
# name, so order and names are frozen as well as types. A struct is written
# as its fields in parentheses.
FROZEN = {
    "interfaces/IParameters.sol:IParameters": {
        "function authority() returns (address) view",
        "function announce(uint256 group,uint256[] values) returns (uint256 countsFrom)",
        "function withdraw(uint256 group)",
        "function valuesAt(uint256 group,uint256 round) returns (uint256[]) view",
        "function pending(uint256 group) returns (uint256[] values,uint256 countsFrom) view",
        "function poolCodeHash() returns (bytes32) view",
        "function buybackValuesAt(uint256 round) returns ((address pool,uint256 burnPpm,"
            "uint256 twapSeconds,uint256 maxSlippagePpm,uint256 buyEveryRounds)) view",
        "event Announced(uint256 indexed group,uint256[] values,uint256 countsFrom)",
        "event Withdrawn(uint256 indexed group,uint256 countsFrom)",
        "error NOT_AUTHORIZED()", "error NOT_ADJUSTABLE()", "error SCHEDULE_RAISED()",
        "error VALUE_OUT_OF_RANGE()", "error IDENTITY_NOT_WHOLE()", "error NOTHING_PENDING()",
        "error POOL_INVALID(address pool)",
    },
    "interfaces/IRegistry.sol:IRegistryV3": {
        "function register()",
        "function setPayout(address node,address payout)",
        "function setOperator(address node,address next)",
        "function acceptOperator(address node)",
        "function isRegistered(address a) returns (bool) view",
        "function isActiveTranscoder(address a) returns (bool) view",
        "function payoutOf(address node) returns (address) view",
        "function operatorOf(address node) returns (address) view",
        "function proposedOperatorOf(address node) returns (address) view",
        "function mayActFor(address caller,address node) returns (bool) view",
        "event NodeRegistered(address indexed node,uint256 round)",
        "event PayoutSet(address indexed node,address payout)",
        "event OperatorProposed(address indexed node,address indexed next)",
        "event OperatorSet(address indexed node,address indexed operator)",
        "error NOT_REGISTERED()", "error PAYOUT_INVALID()", "error NOT_AUTHORIZED()",
        "error OPERATOR_INVALID()",
    },
}

def signature(e):
    def types(ps):
        return ",".join(("(" + types(p["components"]) + ")" + p["type"][len("tuple"):]
                         if p["type"].startswith("tuple") else p["type"])
                        + (" indexed" if p.get("indexed") else "")
                        + (" " + p["name"] if p.get("name") else "") for p in ps)
    text = f"{e['type']} {e['name']}({types(e.get('inputs', []))})"
    if e.get("outputs"):
        text += f" returns ({types(e['outputs'])})"
    if e.get("stateMutability") in ("view", "pure", "payable"):
        text += " " + e["stateMutability"]
    return text

for interface, want in FROZEN.items():
    abi = json.loads(subprocess.run(["forge", "inspect", interface, "abi", "--json"],
                                    check=True, capture_output=True, text=True).stdout)
    got = {signature(e) for e in abi}
    name = interface.split(":")[1]
    for e in sorted(want - got):
        print(f"abi: {name} lacks the frozen {e}")
    for e in sorted(got - want):
        print(f"abi: {name} declares {e}, which the freeze does not")
    failed = failed or got != want
    if got == want:
        print(f"abi: {name} equals its frozen surface")
sys.exit(1 if failed else 0)
EOF
